{
  "name": "lexicon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "start": "node server/index.ts",
    "test": "node --test \"server/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
    "build:client": "vite build --config client/vite.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "dotenv": "^18.0.0",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
